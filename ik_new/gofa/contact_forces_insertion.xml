<mujoco model="pick and place scene">

	<!-- ── Simulation options ───────────────────────────────────────── -->
	<option
	  gravity    = "0 0 -9.81"
	  solver     = "Newton"
	  timestep   = "0.0005"
	  iterations = "200"
	  tolerance  = "1e-10"
	  noslip_iterations = "10"
	  noslip_tolerance  = "1e-10"
	  integrator = "implicitfast"
  />

	<!-- ── Material-class defaults ──────────────────────────────────── -->
	<!--
    MuJoCo friction mixing rule: effective = sqrt(f1 * f2)
    Values below are "self-friction" so mixed pairs come out realistic:
      metal–plastic sliding  : sqrt(0.09 * 0.49) ≈ 0.21  (real ~0.15-0.25)
      metal–wood   sliding   : sqrt(0.09 * 0.64) ≈ 0.24  (real ~0.2-0.3 )
      plastic–wood sliding   : sqrt(0.49 * 0.64) ≈ 0.56  (real ~0.4-0.6)

    condim=6 : enables torsional + rolling friction (pyramid approximation)
    solref / solimp identical across classes — stiffness is a contact property,
    not a material property in this model.
  -->
	<default>
		<!-- Shared contact solver params for all geoms -->
		<geom
		  solref  = "0.001 1"
		  solimp  = "0.95 0.99 0.001 0.5 2"
		  condim  = "6"
    />

		<!-- Steel / aluminium pin -->
		<default class="metal">
			<geom
			  friction = "0.30 0.005 0.0001"
			  contype  = "1"
			  conaffinity = "1"
      />
		</default>

		<!-- ABS / nylon insertion box walls -->
		<default class="plastic">
			<geom
			  friction = "0.70 0.010 0.001"
			  contype  = "1"
			  conaffinity = "1"
      />
		</default>

		<!-- Wooden / MDF table surface -->
		<default class="wood">
			<geom
			  friction = "0.80 0.010 0.001"
			  contype  = "1"
			  conaffinity = "1"
      />
		</default>

		<!-- Rubber floor mat -->
		<default class="rubber">
			<geom
			  friction = "1.60 0.020 0.005"
			  contype  = "1"
			  conaffinity = "1"
      />
		</default>
	</default>

	<statistic meansize=".05"/>

	<visual>
		<headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
		<rgba haze="0.15 0.25 0.35 1"/>
	</visual>

	<asset>
		<texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0"
		  width="512" height="3072"/>
		<texture type="2d" name="groundplane" builtin="checker" mark="edge"
		  rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
		  width="300" height="300"/>
		<material name="groundplane" texture="groundplane" texuniform="true"
		  texrepeat="5 5" reflectance="0.2"/>
	</asset>

	<include file="assets/gofa_asset.xml"/>

	<worldbody>
		<body pos="0 0 0.6">
			<include file="assets/gofa_body.xml"/>
		</body>

	</worldbody>

	<worldbody>
		<light pos="0 0 2" dir="0 0 -1" directional="true"/>

		<geom name="floor" size="0 0 0.05" type="plane"
		  material="groundplane" class="rubber"/>

		<!-- ── Table ─────────────────────────────────── -->
		<body name="table" pos="-0.6 0 0.3">
			<inertial pos="0 0 0" mass="20" diaginertia="2.0 4.0 4.0"/>
			<geom type="box" size="0.75 0.4 0.3" rgba="0.2 0.2 0.2 1"
			  class="wood"/>
		</body>

		<!-- ── Cylinder (steel pin, m=10g, r=8mm, h=60mm) ───────────── -->
		<body name="cylinder_body" pos="0.8 0 1.5" euler="0 90 0" gravcomp="0">
			<inertial pos="0 0 0" mass="0.05"
			  diaginertia="1 1 1"/>
			<freejoint name="cylinder_free"/>
			<site name="cylinder_site" pos="0 0 0.02" euler="0 90 0"/>
			<geom type="cylinder" name ="cylinder_geom" size="0.008 0.03" rgba="0.8 0.1 0.1 1"
			  class="metal"/>
		</body>

		<!-- ── Insertion box (ABS plastic, box-with-hole) ───────────── -->
		<body name="insertion_box" pos="-0.4 0.2 0.62">
			<inertial pos="0 0 0" mass="0.5"
			  diaginertia="3.33e-4 3.33e-4 5.33e-4"/>

			<!-- Visual-only cylinder shows the hole (no collision) -->
			<geom name="hole_visual" type="cylinder" size="0.010 0.021"
			  rgba="0.1 0.1 0.1 1" contype="0" conaffinity="0"/>

			<!-- North wall (+Y) -->
			<geom name="box_wall_n" type="box" size="0.040 0.015 0.020"
			  pos="0  0.025 0" rgba="0.85 0.75 0.3 1" class="plastic"/>

			<!-- South wall (-Y) -->
			<geom name="box_wall_s" type="box" size="0.040 0.015 0.020"
			  pos="0 -0.025 0" rgba="0.85 0.75 0.3 1" class="plastic"/>

			<!-- East wall (+X) -->
			<geom name="box_wall_e" type="box" size="0.015 0.010 0.020"
			  pos=" 0.025 0 0" rgba="0.85 0.75 0.3 1" class="plastic"/>

			<!-- West wall (-X) -->
			<geom name="box_wall_w" type="box" size="0.015 0.010 0.020"
			  pos="-0.025 0 0" rgba="0.85 0.75 0.3 1" class="plastic"/>

			<!-- Bottom floor (cylinder lands here on full insertion) -->
			<geom name="box_floor" type="box" size="0.040 0.040 0.003"
			  pos="0 0 -0.023" rgba="0.85 0.75 0.3 1" class="plastic"/>
		</body>

		<!-- External camera -->
		<camera
		  name       = "external_camera"
		  pos        = "-0.5 0 1.3"
		  euler      = "0 -15 -90"
		  mode       = "fixed"
		  resolution = "1280 720"
		  fovy       = "69"
    />
	</worldbody>

	<!-- ── Explicit contact pair: cylinder ↔ insertion box walls ────── -->
	<!--
    Override with tighter solref for this critical interaction:
    timeconst=0.0005 s = 1× dt → maximally stiff contact resolution.
    Tighter solimp upper bound (0.999) prevents any visible penetration
    during the precision insertion manoeuvre.
  -->
	<contact>
		<pair geom1="cylinder_geom" geom2="box_wall_n"
		  solref="0.0005 1" solimp="0.97 0.999 0.0005 0.5 2" condim="6"/>
		<pair geom1="cylinder_geom" geom2="box_wall_s"
		  solref="0.0005 1" solimp="0.97 0.999 0.0005 0.5 2" condim="6"/>
		<pair geom1="cylinder_geom" geom2="box_wall_e"
		  solref="0.0005 1" solimp="0.97 0.999 0.0005 0.5 2" condim="6"/>
		<pair geom1="cylinder_geom" geom2="box_wall_w"
		  solref="0.0005 1" solimp="0.97 0.999 0.0005 0.5 2" condim="6"/>
		<pair geom1="cylinder_geom" geom2="box_floor"
		  solref="0.0005 1" solimp="0.97 0.999 0.0005 0.5 2" condim="6"/>
	</contact>

	<!-- ── Sensors ──────────────────────────────────────────────────── -->
	<sensor>
		<jointactuatorfrc name="torque_sensor_1" joint="joint1"/>
		<jointactuatorfrc name="torque_sensor_2" joint="joint2"/>
		<jointactuatorfrc name="torque_sensor_3" joint="joint3"/>
		<jointactuatorfrc name="torque_sensor_4" joint="joint4"/>
		<jointactuatorfrc name="torque_sensor_5" joint="joint5"/>
		<jointactuatorfrc name="torque_sensor_6" joint="joint6"/>
	</sensor>

	<!-- ── Constrain cylinder to robot EE ───────────────────────────── -->
	<equality>
		<weld 
			name="cylinder_to_ee" 
			site1="ee_site" 
			site2="cylinder_site"
			solref   = "0.0002 1"
			solimp   = "0.999 0.9999 0.0001 0.5 2"
			/>
	</equality>

</mujoco>